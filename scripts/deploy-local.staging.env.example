# Legacy cloud deploy template.
# Cloud deploy is disabled while New Universe runs on the Windows Docker host.
# Use scripts/deploy-hdc.sh for current deploys.
#
# Keep this file only as a reference for a future migration back to Fly/Pages.
# Copy this file to scripts/deploy-local.staging.env and fill only staging values
# only after cloud deploys are explicitly re-enabled.
# The non-example file is ignored by git.

FLY_API_APP=new-universe-api-staging
FLY_WORKER_APP=new-universe-worker-staging
FLY_PRIMARY_REGION=ams

API_URL=https://new-universe-api-staging.fly.dev
VITE_API_URL=https://new-universe-api-staging.fly.dev
VITE_TG_BOT_NAME=new_universe_game_bot

CLOUDFLARE_PAGES_PROJECT=new-universe-staging
FRONTEND_PAGES_BRANCH=main

# Required for migrations/seed unless DATABASE_URL is set directly.
DATABASE_URL_FILE=/tmp/neon_staging_eu_database_url.txt

# Set these locally if you want deploy-local.sh to stage them into Fly.
SYNC_SECRET_NAMES="DATABASE_URL SENTRY_DSN"
SENTRY_DSN=

# Optional frontend Sentry DSN embedded into the Vite bundle.
VITE_SENTRY_DSN=

# Optional for Cloudflare Pages. If omitted, the script uses your local
# Wrangler login session; run `npx wrangler@latest login` first.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
