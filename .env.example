# New Universe — пример .env для dev
# Скопировать в .env и заполнить значения для своего окружения
# .env НЕ коммитится в git

# ===== Postgres =====
POSTGRES_USER=nu
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=new_universe

# Для `npm run db:migrate` / `npm run db:seed` с хоста (не через `docker compose exec backend …`)
# строка должна совпадать с пользователем/паролем/БД выше и хостом localhost:
# DATABASE_URL=postgres://nu:devpassword@127.0.0.1:5432/new_universe

# ===== Telegram =====
# Получить токен у @BotFather в Telegram (/newbot)
# Для dev лучше создать отдельного тест-бота, например NewUniverseDevBot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET=dev-secret-change-me-32-chars
# Список Telegram user_id, которым разрешены админ-команды (через запятую)
ADMIN_TELEGRAM_IDS=
# Список chat_id, куда приходят запросы /paysupport; если пусто, используется ADMIN_TELEGRAM_IDS
ADMIN_TELEGRAM_CHAT_IDS=

# ===== Секреты сервера =====
# В проде заменить на длинные случайные строки (32+ символов) из secret storage
JWT_SECRET=dev-jwt-secret-change-me-32-chars
SERVER_SECRET=dev-server-secret-change-me-32-chars

# ===== Rate limits (опционально; см. backend/src/lib/rate-limit.ts) =====
# RATE_LIMIT_WINDOW=1 minute
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_MUTATION_MAX=120
# RATE_LIMIT_WEBHOOK_MAX=600
# По умолчанию лимиты считаются in-memory, чтобы обычный HTTP-трафик не расходовал Redis.
# Для нескольких backend-реплик можно включить общий Redis-store:
# RATE_LIMIT_STORE=redis

# ===== Очереди =====
# true (по умолчанию): delayed jobs can use BullMQ/Redis.
# false: due work is completed by Postgres polling/online sync, without BullMQ enqueue/workers.
ENABLE_BULLMQ=true

# ===== Логирование =====
# debug | info | warn | error
LOG_LEVEL=debug

# ===== Алмазы / rush построек (опционально; см. backend/src/lib/env.ts для умолчаний) =====
# DIAMOND_STARTING_GRANT=1000
# Прогрессивная формула ускорения: round((minutes^0.85) * DIAMOND_RUSH_PER_MINUTE)
# Пример при коэффициенте 1: 1м≈1, 10м≈7, 100м≈50
# DIAMOND_RUSH_PER_MINUTE=1
# DIAMOND_RUSH_MAX_PER_ACTION=0

# ===== Sentry (необязательно для dev) =====
SENTRY_DSN=

# ===== Frontend =====
# URL бэкенда — для обращений из браузера
# Локально: http://localhost:3000
# В Docker (container-to-container): http://backend:3000
# Для прокси через nginx: /api (относительный путь)
VITE_API_URL=http://localhost:3000
VITE_TG_BOT_NAME=NewUniverseDevBot

# ===== Tunnels (опционально для тестов в Telegram) =====
# Если используешь cloudflared tunnel или ngrok — впишешь URL сюда
PUBLIC_FRONTEND_URL=
PUBLIC_BACKEND_URL=
