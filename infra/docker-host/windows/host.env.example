# New Universe Windows Docker host env template
# Copy to C:\new-universe\env\prod.env or C:\new-universe\env\test.env.
# Do not commit filled copies.

# ===== Instance identity =====
NEW_UNIVERSE_ENV=prod
COMPOSE_PROJECT_NAME=new-universe-prod

# ===== Public domain mapping =====
# Use test.new-universe/test-new-universe-api for the test instance.
APP_DOMAIN=new-universe.tg-games.com
API_DOMAIN=new-universe-api.tg-games.com
PUBLIC_FRONTEND_URL=https://new-universe.tg-games.com
TELEGRAM_APP_URL=https://new-universe.tg-games.com
VITE_API_URL=https://new-universe-api.tg-games.com
VITE_TG_BOT_NAME=NewUniverseBot

# ===== Existing Home Data Center Cloudflare Tunnel network =====
# The hdc-cloudflared container runs outside this stack in D:\HomeDataCenter.
# Attach API/frontend to this shared Docker network and route public hostnames to the aliases.
HDC_TUNNEL_NETWORK=hdc-tunnel
TUNNEL_FRONTEND_ALIAS=nu-prod-frontend
TUNNEL_API_ALIAS=nu-prod-api

# ===== Postgres container =====
POSTGRES_USER=nu
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=new_universe
DATABASE_URL=postgres://nu:replace-with-long-random-password@postgres:5432/new_universe
POSTGRES_DATA_TYPE=bind
POSTGRES_DATA_SOURCE=D:/new-universe/state/prod/postgres

# ===== Redis container =====
REDIS_URL=redis://redis:6379
REDIS_DATA_TYPE=bind
REDIS_DATA_SOURCE=D:/new-universe/state/prod/redis

# ===== Backend runtime =====
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_BOT_SECRET=replace-with-32-plus-character-webhook-secret
JWT_SECRET=replace-with-32-plus-character-jwt-secret
SERVER_SECRET=replace-with-current-staging-server-secret-if-migrating-existing-worlds
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_CHAT_IDS=

# ===== Rate limits / queues =====
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MUTATION_MAX=120
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_STORE=memory
ENABLE_BULLMQ=true

# ===== Economy overrides =====
DIAMOND_STARTING_GRANT=0
DIAMOND_RUSH_PER_MINUTE=1
DIAMOND_RUSH_MAX_PER_ACTION=0

# ===== Optional observability =====
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.01
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1.0
